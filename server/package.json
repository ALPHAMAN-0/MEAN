{
  "name": "@mean/server",
  "version": "1.0.0",
  "description": "Express 5 API: JWT auth with rotating refresh tokens, Mongoose 9, zod-validated everything.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node init && tsx watch src/server.ts",
    "build": "node init && tsc -p tsconfig.build.json",
    "start": "node init && node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx src/scripts/seed.ts",
    "indexes": "tsx src/scripts/sync-indexes.ts"
  },
  "dependencies": {
    "@mean/shared": "*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "mongoose": "^9.10.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-dist": "5.33.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "vitest": "4.1.11"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.2.6"
    }
  }
}
