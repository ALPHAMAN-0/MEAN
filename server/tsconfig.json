{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // The lint/typecheck project: sources, tests and the vitest config.
  // rootDir/outDir live in tsconfig.build.json — they cannot cover this wider set.
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
