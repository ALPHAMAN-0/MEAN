# ---------------------------------------------------------------------------
# Copy to .env before anything else:   cp .env.example .env
# Every value here is a safe local-development default. Nothing here is a
# secret you may reuse in production — run `npm run gen:secret` for that.
# ---------------------------------------------------------------------------

# --- API ---------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# Hop count for express-rate-limit / req.ip. 0 on the host, 1 behind the nginx
# service in docker-compose.full.yml. Never `true` — rate-limit v8 rejects it.
TRUST_PROXY=0

# The Angular dev server. CORS_ORIGINS defaults to http://localhost:${CLIENT_PORT}
# when left unset, so change the port in ONE place.
CLIENT_PORT=4200
# CORS_ORIGINS=http://localhost:4200,http://localhost:8080

# --- Auth --------------------------------------------------------------------
# Min 32 chars. The env schema REFUSES this dev value when NODE_ENV=production.
JWT_ACCESS_SECRET=dev-only-insecure-secret-change-me-at-least-32-chars
JWT_ISSUER=mean-boilerplate
JWT_AUDIENCE=mean-client
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=refresh_token
# The refresh cookie is scoped to the auth routes: it is never sent with an
# ordinary API call, so an XSS cannot ride it on /api/v1/tasks.
REFRESH_COOKIE_PATH=/api/v1/auth
# scrypt work factor as a power of two. 17 = OWASP guidance (~250ms/128MiB here).
# The test suite overrides this to 14 — see server/vitest.config.ts.
PASSWORD_SCRYPT_COST=17

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Failed register/login attempts per window per IP. Production wants 10-20;
# this is deliberately loose so learning does not lock you out.
AUTH_RATE_LIMIT_MAX=100

# --- API docs ----------------------------------------------------------------
SWAGGER_ENABLED=true

# --- MongoDB -----------------------------------------------------------------
# TWO URIs, and the difference matters.
#
# FROM THE HOST (npm run dev, npm run seed): 127.0.0.1 and directConnection=true.
#   - 127.0.0.1, not localhost: Node resolves ::1 first and Docker's published
#     port does not bind it.
#   - directConnection=true: rs0 advertises its member as `mongo:27017`, which
#     only resolves inside the compose network. Without this the driver discards
#     your seed address, tries to reach `mongo`, and times out.
MONGO_URI=mongodb://mean_app:devapp@127.0.0.1:27017/meandb?authSource=meandb&directConnection=true
#
# FROM ANOTHER CONTAINER (docker-compose.full.yml) — real replica-set discovery:
#   mongodb://mean_app:devapp@mongo:27017/meandb?authSource=meandb&replicaSet=rs0

MONGO_PORT=27017
MONGO_DB=meandb
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=devroot
MONGO_APP_USERNAME=mean_app
MONGO_APP_PASSWORD=devapp

# --- mongo-express (DB browser on :8081) -------------------------------------
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=devadmin

# --- Seed data ---------------------------------------------------------------
SEED_EMAIL=demo@example.com
SEED_PASSWORD=Password123!
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Password123!

# --- Docker / tooling --------------------------------------------------------
COMPOSE_PROJECT_NAME=mean
WEB_PORT=8080
# mongodb-memory-server downloads this mongod for the test suite (no Docker needed).
MONGOMS_VERSION=8.2.6
