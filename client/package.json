{
  "name": "@mean/client",
  "version": "1.0.0",
  "scripts": {
    "dev": "node init && ng serve --port ${CLIENT_PORT:-4200}",
    "start": "node init && npm run dev",
    "build": "node init && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "private": true,
  "dependencies": {
    "@mean/shared": "*",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "vitest": "4.1.11"
  },
  "license": "MIT",
  "description": "Angular 22 client: standalone components, signals, zoneless."
}
